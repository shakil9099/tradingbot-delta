{
  "name": "tradingbot-eth",
  "version": "0.1.0",
  "private": true,
  "description": "ETHUSD perpetual trading bot for Delta Exchange India (Hull / UT Bot adaptive).",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc && npm --prefix web ci && npm --prefix web run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.scripts.json",
    "backtest": "tsx scripts/backtest.ts",
    "ctl": "tsx scripts/ctl.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "smoke": "tsx scripts/smoke.ts",
    "research5": "tsx scripts/research5.ts",
    "patterns": "tsx scripts/patterns.ts",
    "research5b": "tsx scripts/research5b.ts",
    "riskmc": "tsx scripts/riskmc.ts",
    "trail20": "tsx scripts/trail20.ts",
    "throttle": "tsx scripts/throttle.ts",
    "livesim": "tsx scripts/livesim.ts",
    "fresh": "tsx scripts/fresh.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "cookie-session": "2.1.1",
    "dotenv": "17.2.3",
    "express": "4.22.3",
    "pino": "9.6.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/cookie-session": "2.0.49",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "2.1.8",
    "supertest": "7.1.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
