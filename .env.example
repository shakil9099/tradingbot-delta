# ---- Delta Exchange India API ----
# Trade-only key, no withdrawal permission, IP-whitelisted to the VPS.
# Optional: leave empty and upload the keys from the dashboard (Settings) instead.
DELTA_API_KEY=
DELTA_API_SECRET=
# Production: https://api.india.delta.exchange   Testnet: https://cdn-ind.testnet.deltaex.org
DELTA_BASE_URL=https://api.india.delta.exchange

# Encrypts API keys saved from the dashboard (Settings page). Generate with: openssl rand -hex 32
# Keep it safe: if it changes, stored keys become unreadable and must be re-entered.
SECRETS_KEY=
# auto = keys saved from the dashboard, else the DELTA_API_KEY/SECRET above. env = only the .env keys (recovery).
CREDENTIALS_SOURCE=auto

# ---- Dashboard and ctl ----
DASHBOARD_USER=admin
# Generate with: npm run hash-password
DASHBOARD_PASSWORD_HASH=
# Generate each with: openssl rand -hex 32
SESSION_SECRET=
CTL_TOKEN=

# ---- Safety ----
# Live mode needs isolated margin confirmed: tick the box in the dashboard Go-live dialog, or set this to true.
ISOLATED_MARGIN_CONFIRMED=false

# ---- Telegram alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Runtime ----
PORT=3000
# true = LOCK to paper trading (the dashboard Go-live button is disabled).
# false = live trading is allowed, but only after you press Go live in the dashboard (Settings).
DRY_RUN=false
# DRY_RUN starting balance in USD
PAPER_BALANCE=141
# Upper cap on order size in contracts (1 contract = 0.01 ETH). 100000 = no cap in practice.
MAX_CONTRACTS=100000
# adaptive | hull | ut
STRATEGY=adaptive
LEVERAGE=20
# ---- Strategy v2 (design Amendment A) ----
# Share of the balance lost if the initial stop is hit (fees included). Max 0.3.
RISK_PER_TRADE=0.2
# Risk used while the balance is more than RISK_REDUCE_DD below its peak.
RISK_REDUCED=0.05
RISK_REDUCE_DD=0.2
# Skip NEW entries while 1h ATR(14) is below this many dollars (0 = off).
MIN_ATR=15
# Optional: also skip NEW entries while ATR(14) is above this many dollars (0 = off).
ATR_GATE_MAX=0
# No new entries on Saturday/Sunday IST (open trades are still managed). true | false
SKIP_WEEKEND_ENTRIES=true
# false only for local testing over plain http; keep true behind Caddy/HTTPS
COOKIE_SECURE=true
DATA_DIR=data
